# ==============================================================================
# System Revamp v2.0 — Production Environment Configuration
# ==============================================================================

# Server Network Configuration
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database Connection (SQLite WAL mode by default; or PostgreSQL for >500 hosts)
# SQLite default: sqlite:///server_data/fleet.db
DATABASE_URL=sqlite:///server_data/fleet.db
# PostgreSQL Tier 3/4 example:
# DATABASE_URL=postgresql://revamp_user:SecurePassword@127.0.0.1:5432/system_revamp

# Cryptographic Keys (Must be 256-bit CSPRNG hex; generate via `openssl rand -hex 32`)
# Signs Admin session JWT tokens
SECRET_KEY=
# Signs remote remediation commands and offline intelligence bundles
DEVICE_SIGNING_KEY=

# Initial SuperAdmin Provisioning (Used during automated bootstrapping)
ADMIN_EMAIL=admin@systemrevamp.local
ADMIN_PASSWORD=Admin@123456

# Threat Intelligence & VirusTotal Integration (Optional)
VT_API_KEY=
VT_RATE_LIMIT_PER_MINUTE=4

# Rate Limits & Ingestion Tunables
AUTH_RATE_LIMIT_PER_MINUTE=15
AGENT_POLL_INTERVAL_MINUTES=5
