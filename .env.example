# System Revamp - Environment Configuration

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=system_revamp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/system_revamp

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Threat Protection & VirusTotal API
# Obtain from https://www.virustotal.com/
VT_API_KEY=
VT_RATE_LIMIT_PER_MINUTE=4

# Shared Internal Service Auth Key (Task 2)
# When unset/empty, services run in frictionless local dev mode.
# When set, all REST requests must include X-Internal-Key header.
INTERNAL_API_KEY=system-revamp-internal-key-change-me
REACT_APP_INTERNAL_API_KEY=system-revamp-internal-key-change-me

